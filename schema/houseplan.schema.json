{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scan-to-sketchup.local/schema/houseplan-0.1.json",
  "title": "HousePlan",
  "description": "Canonical house model. Every input converts to this; every output reads from it. All lengths are millimeters. Plan axes match SketchUp: +x along the front wall (red), +y toward the back (green), z up (blue); origin at the front-left exterior corner.",
  "type": "object",
  "required": ["schemaVersion", "units", "source", "orientation", "levels"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "units": { "const": "mm", "description": "Storage units. Always mm." },
    "displayUnits": {
      "enum": ["imperial", "metric"],
      "default": "imperial",
      "description": "How lengths are shown to the user and in SketchUp names (Door 32x80 vs Door 813x2032)."
    },
    "source": { "$ref": "#/$defs/source" },
    "orientation": { "$ref": "#/$defs/orientation" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/level" }
    },
    "measurements": {
      "type": "array",
      "items": { "$ref": "#/$defs/measurement" },
      "description": "Audit trail of measured values. Manual and laser values override scanned geometry."
    }
  },
  "additionalProperties": false,

  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "minLength": 1 },
    "length": { "type": "number", "minimum": 0 },
    "positiveLength": { "type": "number", "exclusiveMinimum": 0 },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Scanner confidence. Absent means entered or confirmed by the user."
    },
    "point2": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
      "additionalProperties": false
    },

    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["manual", "roomplan", "import", "blueprint", "photo"] },
        "capturedAt": { "type": "string", "format": "date-time" },
        "app": { "type": "string", "description": "Originating app for imports." },
        "fileName": { "type": "string" }
      },
      "additionalProperties": false
    },

    "orientation": {
      "type": "object",
      "required": ["northAngleDeg", "headingSource"],
      "properties": {
        "northAngleDeg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360,
          "description": "Clockwise angle from plan +y (SketchUp green) to true north, in degrees."
        },
        "headingSource": { "enum": ["compass", "map", "manual", "none"] },
        "address": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "additionalProperties": false
    },

    "defaults": {
      "type": "object",
      "description": "Values used when adding new elements. Seeded from schema/regional-defaults.json by the address's region.",
      "properties": {
        "region": { "type": "string", "description": "Key into regional-defaults.json, e.g. US." },
        "interiorWallThickness": { "$ref": "#/$defs/positiveLength" },
        "exteriorWallThickness": { "$ref": "#/$defs/positiveLength" },
        "ceilingHeight": { "$ref": "#/$defs/positiveLength" }
      },
      "additionalProperties": false
    },

    "level": {
      "type": "object",
      "required": ["id", "name", "elevation", "floorToCeiling", "walls", "openings", "rooms"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "elevation": { "type": "number", "description": "Finished floor height above level 1, mm." },
        "floorToCeiling": { "$ref": "#/$defs/positiveLength" },
        "walls": { "type": "array", "items": { "$ref": "#/$defs/wall" } },
        "openings": { "type": "array", "items": { "$ref": "#/$defs/opening" } },
        "rooms": { "type": "array", "items": { "$ref": "#/$defs/room" } }
      },
      "additionalProperties": false
    },

    "wall": {
      "type": "object",
      "description": "A straight wall segment. start/end are the centerline. 'Left' and 'right' faces are as seen walking from start to end. Walls meet only at endpoints; a wall that another wall tees into must be split at that point.",
      "required": ["id", "start", "end", "thickness", "isExterior"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": ["solid", "separator"],
          "default": "solid",
          "description": "separator = invisible room boundary for open-plan spaces; never generates geometry."
        },
        "start": { "$ref": "#/$defs/point2" },
        "end": { "$ref": "#/$defs/point2" },
        "thickness": { "$ref": "#/$defs/length" },
        "height": { "$ref": "#/$defs/positiveLength", "description": "Defaults to the tallest ceiling of the rooms it bounds, else level floorToCeiling." },
        "isExterior": { "type": "boolean" },
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "additionalProperties": false,
      "if": { "properties": { "kind": { "const": "separator" } }, "required": ["kind"] },
      "then": { "properties": { "thickness": { "const": 0 }, "isExterior": { "const": false } } },
      "else": { "properties": { "thickness": { "exclusiveMinimum": 0 } } }
    },

    "opening": {
      "type": "object",
      "required": ["id", "wallId", "type", "offsetFromStart", "width", "height", "sillHeight"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "wallId": { "$ref": "#/$defs/id" },
        "type": { "enum": ["door", "window", "opening"] },
        "offsetFromStart": {
          "$ref": "#/$defs/length",
          "description": "Distance along the wall centerline from the wall's start point to the near edge of the opening."
        },
        "width": { "$ref": "#/$defs/positiveLength" },
        "height": { "$ref": "#/$defs/positiveLength" },
        "sillHeight": { "$ref": "#/$defs/length", "description": "0 for doors and floor-level openings." },
        "operation": {
          "enum": ["hinged", "double", "sliding", "pocket", "bifold", "fixed", "casement", "single-hung", "double-hung"],
          "description": "How the door or window operates."
        },
        "swing": {
          "type": "object",
          "description": "For hinged/double doors. Directions are relative to the wall's start-to-end direction.",
          "required": ["hingeEnd", "openSide"],
          "properties": {
            "hingeEnd": { "enum": ["start", "end"], "description": "Which edge of the opening the hinges are on." },
            "openSide": { "enum": ["left", "right"], "description": "Which side of the wall the leaf swings into." }
          },
          "additionalProperties": false
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "additionalProperties": false
    },

    "room": {
      "type": "object",
      "required": ["id", "name", "type", "boundaryWallIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "description": "Drives SketchUp group names, e.g. Floor - Kitchen." },
        "type": {
          "enum": ["living", "family", "great-room", "kitchen", "dining", "bedroom", "primary-bedroom", "bathroom", "half-bath",
                   "office", "hallway", "entry", "closet", "laundry", "utility", "garage", "stairs", "other"]
        },
        "boundaryWallIds": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/id" },
          "description": "Walls in order around the room; consecutive walls share an endpoint and the last connects back to the first."
        },
        "ceilingHeight": { "$ref": "#/$defs/positiveLength", "description": "Overrides the level's floorToCeiling for this room." }
      },
      "additionalProperties": false
    },

    "measurement": {
      "type": "object",
      "required": ["targetId", "field", "value", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "targetId": { "$ref": "#/$defs/id", "description": "A wall, opening or room id." },
        "field": { "enum": ["length", "thickness", "height", "width", "offsetFromStart", "sillHeight", "ceilingHeight"] },
        "face": {
          "enum": ["left", "right", "center"],
          "description": "For wall lengths: which face was measured. Users measure inside faces; the editor maps 'inside Kitchen' to left/right."
        },
        "roomId": { "$ref": "#/$defs/id", "description": "Room the measurement was taken from, for display." },
        "value": { "$ref": "#/$defs/length" },
        "source": { "enum": ["scan", "manual", "laser"] },
        "takenAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
